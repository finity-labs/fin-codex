includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    paths:
        - src
    level: 5
    ignoreErrors:
        # WithHelp is meant for host resources and pages; nothing under src/ uses it,
        # so PHPStan has no using class to analyse it against.
        -
            identifier: trait.unused
            path: src/Help/WithHelp.php
        # Larastan resolves make(ContentSource::class) to the bound DeclaredContextsSource on
        # some dependency sets and to the interface on others, so the instanceof guard in
        # forgetSourceMemoOnWrite() is "always true" under Filament ^5 and not under ^4.
        # A host may rebind the source without the decorator, so the guard stays.
        -
            identifier: instanceof.alwaysTrue
            path: src/FinCodexServiceProvider.php
            reportUnmatched: false
